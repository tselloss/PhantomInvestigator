ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com
ANTHROPIC_MODEL=claude-haiku-4-5    # cheapest model that still handles the tool-use loop well
JUDGE_MODEL=claude-haiku-4-5        # eval judge, independent of ANTHROPIC_MODEL

# Bring-your-own-key: the AI provider that powers the investigation loop and
# screenshot vision pre-pass. Whoever self-hosts this deployment pays for
# their own usage -- configure it here OR from the running app's Settings ->
# Integrations page (which takes priority and needs no restart to apply).
# When AI_PROVIDER=anthropic and AI_API_KEY/AI_MODEL are left blank, they
# fall back to ANTHROPIC_API_KEY/ANTHROPIC_MODEL above.
AI_PROVIDER=anthropic               # anthropic | openai | openai_compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=                        # only used when AI_PROVIDER=openai_compatible
EMBEDDING_API_KEY=                  # your embedding provider key (Voyage AI)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/investigator
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
MAX_AGENT_STEPS=14                  # bumped from 10 -- the tool belt roughly doubled (5 -> 9 tools)
MAX_COST_EUR_PER_RUN=0.50           # hard cap per /investigate call; loop aborts early past this

# Session signing for real per-user accounts (register/login from the UI --
# no admin credential to set here anymore; the first person to register on
# your instance is just the first user, like anyone else).
# Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=
# Session cookie is Secure by default (requires HTTPS). Set to false only for
# plain-HTTP local dev with no TLS termination in front of the app.
SESSION_COOKIE_SECURE=true

# Optional: "Continue with Google" on the login/register pages. Create an
# OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the exact
# redirect URI below as an "Authorized redirect URI" there.
# Leave blank to keep username/password as the only sign-in method.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8085/auth/google/callback

# Encrypts integration credentials saved from the Integrations page (stored
# in Postgres, never in plaintext). Without this set, that page falls back
# to read-only (.env-configured integrations still work; saving new ones
# from the UI fails with a clear error instead of storing anything).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Jira (Phase B) — Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=                # shared secret, checked as ?secret= on the inbound webhook URL

# Azure DevOps Boards — personal access token needs Work Items (Read & Write) scope:
# https://dev.azure.com/{organization}/_usersSettings/tokens
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# Zendesk — customer support ticket search (read-only). API token:
# https://support.zendesk.com/hc/en-us/articles/4408886839578
ZENDESK_SUBDOMAIN=                   # the "acme" in acme.zendesk.com
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# GitHub Actions (Phase C) — PAT needs repo + actions:read scopes
GITHUB_TOKEN=
GITHUB_REPO=owner/repo               # the repo whose Actions runs/deploys get investigated
GITHUB_WEBHOOK_SECRET=               # used to verify X-Hub-Signature-256 on the inbound webhook

# Azure Monitor (Phase F) — AAD service principal (app registration), Log Analytics workspace.
# Logs and metrics are separate SDKs/endpoints as of the current Azure SDK layout.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_METRICS_ENDPOINT=            # regional, e.g. https://westeurope.metrics.monitor.azure.com

# AWS CloudWatch (Phase F) — scope this IAM user/role to read-only CloudWatch Logs/Metrics access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Self-hosted Langfuse (see docker-compose.yml). Generate with:
#   openssl rand -hex 32   (SALT, ENCRYPTION_KEY, NEXTAUTH_SECRET)
#   openssl rand -hex 16   (the *_PASSWORD / *_AUTH secrets)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_PASSWORD=
# Project API keys the agent uses to send traces — must match LANGFUSE_INIT_PROJECT_* below
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000
# Auto-provisions the org/project/user on first boot — no manual UI setup
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=phantom-investigator
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=phantom-investigator
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=
