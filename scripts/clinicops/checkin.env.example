# Copy to /etc/clinicops-checkin.env (or wherever checkin.service's
# EnvironmentFile points) and fill in real values.
#
# For this pass ClinicOps runs locally alongside PhantomInvestigator, so
# http://localhost:8085 reaches it directly -- no tunnel needed. If/when
# ClinicOps's own CI (.github/workflows/ci.yml's deploy job, which already
# triggers a VPS/Coolify/Dokku webhook) calls this from a GitHub-hosted
# runner instead of locally, swap this for a real public PhantomInvestigator
# URL (tunnel or stable host), since GitHub's runners can't reach localhost.
PHANTOM_BASE_URL=http://localhost:8085
DEPLOYMENT_ID=
CHECKIN_SECRET=
